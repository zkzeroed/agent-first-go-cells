#!/usr/bin/env bash
# pre-commit hook — fast architecture checks before each commit.
#
# Runs `task doctor` (manifests, index, structure tests, AGENTS.md, import policy)
# and `task secrets` (hardcoded-secret scan), but skips the full build and test
# suite for speed. Fails the commit if an architecture invariant or potential
# secret is found.
#
# INSTALLATION:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or configure git to use the .githooks directory:
#   git config core.hooksPath .githooks
#
# WHY IT HELPS AGENTS: An agent using git to commit will trigger this hook
# automatically, catching architecture violations before they enter the repo.
# This is the first line of defense — CI is the second.
set -euo pipefail

echo "Running architecture health check (task doctor)..."
if task doctor 2>&1; then
    echo "✓ Pre-commit: architecture checks passed."
else
    echo "✗ Pre-commit: architecture checks FAILED. Commit aborted."
    echo "  Run 'task doctor' to see details."
    exit 1
fi

echo "Scanning for hardcoded secrets (task secrets)..."
if task secrets 2>&1; then
    echo "✓ Pre-commit: secret scan passed."
else
    echo "✗ Pre-commit: secret scan FAILED. Commit aborted."
    echo "  Run 'task secrets' to see details."
    exit 1
fi
